{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ShitCam",
  "scopeName": "source.shitcam",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#builtins" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.shitcam",
          "match": "//.*$"
        },
        {
          "name": "comment.line.number-sign.shitcam",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.shitcam",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.shitcam",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.shitcam",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.shitcam",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.shitcam",
          "match": "\\b(if|else|while|for|in|return|break|continue|import)\\b"
        },
        {
          "name": "keyword.declaration.function.shitcam",
          "match": "\\bfn\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.shitcam",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.shitcam",
          "match": "\\bnull\\b"
        },
        {
          "name": "variable.language.shitcam",
          "match": "\\bargs\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.shitcam",
          "match": "\\b(print|println|input|length|lower|upper|contains|substring|push|pop|read_file|write_file|file_exists|delete_file|make_dir|get_env|set_env|system|set_color|set_clipboard|get_clipboard|http_get|abs|min|max|sqrt|time|sleep|beep|random|alert)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\bfn\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "entity.name.function.shitcam"
            }
          }
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.shitcam"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.compound.shitcam",
          "match": "(\\+=|-=|\\*=|\\/=)"
        },
        {
          "name": "keyword.operator.arithmetic.shitcam",
          "match": "(\\+|\\-|\\*|\\/|%)"
        },
        {
          "name": "keyword.operator.comparison.shitcam",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.shitcam",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.assignment.shitcam",
          "match": "(=)"
        }
      ]
    }
  }
}
